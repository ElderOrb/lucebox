+// x + y*g with g broadcast over rows (a per-channel gate): the gated residual of a DiT block in one pass.
+static __global__ void mul_add_f32(const float * x, const float * y, const float * g, float * dst, const int64_t n, const int64_t ne0) {
+    const int64_t i = (int64_t) blockIdx.x*blockDim.x + threadIdx.x;
+    if (i >= n) {
+        return;
+    }
+    dst[i] = __fadd_rn(x[i], __fmul_rn(y[i], g[i % ne0]));
+}
+
+bool ggml_cuda_should_fuse_mul_add(const ggml_tensor * mul, const ggml_tensor * add) {
+    const ggml_tensor * x = add->src[0] == mul ? add->src[1] : add->src[0];
+    const ggml_tensor * y = mul->src[0];
+    const ggml_tensor * g = mul->src[1];
+    if (mul->type != GGML_TYPE_F32 || add->type != GGML_TYPE_F32 || x->type != GGML_TYPE_F32 || y->type != GGML_TYPE_F32 ||
+            g->type != GGML_TYPE_F32) {
+        return false;
+    }
+    return ggml_is_contiguous(x) && ggml_is_contiguous(y) && ggml_is_contiguous(g) && ggml_is_contiguous(add) &&
+           ggml_are_same_shape(x, y) && ggml_are_same_shape(add, y) && g->ne[0] == y->ne[0] && ggml_nelements(g) == y->ne[0];
+}
+
+void ggml_cuda_op_mul_add_fused(ggml_backend_cuda_context & ctx, ggml_tensor * mul, ggml_tensor * add) {
+    const ggml_tensor * x = add->src[0] == mul ? add->src[1] : add->src[0];
+    const int64_t n = ggml_nelements(add);
+    const int block = 256;
+    mul_add_f32<<<(n + block - 1)/block, block, 0, ctx.stream()>>>(
+        (const float *) x->data, (const float *) mul->src[0]->data, (const float *) mul->src[1]->data, (float *) add->data,
+        n, mul->src[0]->ne[0]);
+}

 }
 
+template<typename src_t, typename dst_t>
+static __global__ void cpy_rows_contiguous(const char * cx, char * cdst, const int64_t ne00, const int64_t ne01,
+                                           const int64_t ne02, const int64_t nb01, const int64_t nb02, const int64_t nb03,
+                                           const int64_t nrows) {
+    const int64_t row = (int64_t) blockIdx.x * blockDim.y + threadIdx.y;
+    if (row >= nrows) {
+        return;
+    }
+    const int64_t i01 = row % ne01;
+    const int64_t i02 = (row / ne01) % ne02;
+    const int64_t i03 = row / (ne01 * ne02);
+    const src_t * x   = (const src_t *) (cx + i01 * nb01 + i02 * nb02 + i03 * nb03);
+    dst_t *       dst = (dst_t *) cdst + row * ne00;
+    for (int64_t i = threadIdx.x; i < ne00; i += blockDim.x) {
+        dst[i] = ggml_cuda_cast<dst_t>(x[i]);
+    }
+}
+
+// src rows contiguous (nb00 == element size), dst contiguous: one 32-thread row per block row, 8 rows per block.
+template<typename src_t, typename dst_t>
+static void ggml_cpy_rows_contiguous_cuda(const char * cx, char * cdst, const int64_t ne00, const int64_t ne01,
+                                          const int64_t ne02, const int64_t nb01, const int64_t nb02, const int64_t nb03,
+                                          const int64_t nrows, cudaStream_t stream) {
+    const dim3 block(32, 8, 1);
+    const dim3 grid((nrows + block.y - 1) / block.y, 1, 1);
+    cpy_rows_contiguous<src_t, dst_t><<<grid, block, 0, stream>>>(cx, cdst, ne00, ne01, ne02, nb01, nb02, nb03, nrows);
+}

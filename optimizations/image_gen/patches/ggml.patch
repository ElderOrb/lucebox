+    const float scale = rsqrtf(sumsq / (2*half_dim) + eps);
+
+    for (int64_t j = lane; j < half_dim; j += WARP_SIZE) {
+        const int64_t i0 = interleaved ? 2*j : j;
+        const int64_t i1 = interleaved ? 2*j + 1 : j + half_dim;
+        const float a = __fmul_rn(__fmul_rn(scale, load(i0)), w[i0]);
+        const float b = __fmul_rn(__fmul_rn(scale, load(i1)), w[i1]);
+        const float * matrix = pe_token + j*pe_s2;
+        const float c = matrix[0];
+        const float s = matrix[pe_s1];
+        float o0;
+        float o1;
+        if (interleaved) {
+            o0 = __fadd_rn(__fmul_rn(a, c), __fmul_rn(b, matrix[pe_s0]));
+            o1 = __fadd_rn(__fmul_rn(a, s), __fmul_rn(b, matrix[pe_s0 + pe_s1]));
+        } else {
+            o0 = __fsub_rn(__fmul_rn(a, c), __fmul_rn(b, s));
+            o1 = __fadd_rn(__fmul_rn(a, s), __fmul_rn(b, c));
+        }
+        out[i0] = ggml_cuda_cast<T_dst>(o0);
+        out[i1] = ggml_cuda_cast<T_dst>(o1);
+    }
+}
 

+
+__device__ __forceinline__ float ggml_cuda_op_situ_single(float gate, float up, float gate_cap, float up_cap) {
+    const float a = tanhf(gate * (1.0f / gate_cap)) * gate_cap * (1.0f / (1.0f + expf(-gate)));
+    return a * (tanhf(up * (1.0f / up_cap)) * up_cap);
+}

+// ggml_situ
+
+struct ggml_tensor * ggml_situ(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * a,
+        struct ggml_tensor  * b,
+        float                 gate_cap,
+        float                 up_cap) {
+    struct ggml_tensor * result = ggml_glu_impl(ctx, a, b, GGML_GLU_OP_SITU, false);
+    ggml_set_op_params_f32(result, 2, gate_cap);
+    ggml_set_op_params_f32(result, 3, up_cap);
+
+    return result;
+}
+
+struct ggml_tensor * ggml_situ_swapped(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * a,
+        float                 gate_cap,
+        float                 up_cap) {
+    struct ggml_tensor * result = ggml_glu_impl(ctx, a, NULL, GGML_GLU_OP_SITU, true);
+    ggml_set_op_params_f32(result, 2, gate_cap);
+    ggml_set_op_params_f32(result, 3, up_cap);
+
+    return result;
+}
